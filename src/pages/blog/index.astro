---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { posts } from '../../data/posts';
const [destaque, ...resto] = posts;
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('pt-BR');
---
<Base title="Blog de saúde da EmCORR: dicas para a família" description="Exames, saúde das crianças, coração, dentes e alimentação explicados pela equipe da EmCORR, em Corrente-PI." nav="Blog">
  <Crumbs items={[['Início', '/'], ['Blog']]} />
  <section class="wrap stack gap-20" style="padding-top:32px;padding-bottom:36px;max-width:980px">
    <span class="eyebrow">Saúde em família</span>
    <h1 class="h1">Blog de saúde da <em>EmCORR</em></h1>
    <p class="lead">Respostas para as dúvidas que mais chegam à recepção.</p>
  </section>
  <section class="wrap" style="padding-bottom:56px">
    <a class="split" href={`/blog/${destaque.slug}`} style="border-radius:28px;overflow:hidden;background:var(--cream-50);color:var(--ink-700);gap:0">
      <img src={destaque.capa} alt="" width="830" height="560" style="width:100%;height:100%;min-height:320px;object-fit:cover" />
      <div class="stack gap-16" style="padding:48px"><span class="eyebrow">Destaque · {destaque.categoria}</span><strong style="font:600 32px/1.2 Poppins;color:var(--ink-900)">{destaque.titulo}</strong><span style="font-size:17px">{destaque.resumo}</span><span class="small muted">{destaque.autor} · {fmt(destaque.data)} · {destaque.leitura} de leitura</span><span style="font-weight:500;color:var(--red-700)">Ler artigo →</span></div>
    </a>
  </section>
  {resto.length > 0 && <section class="wrap grid g3" style="padding-bottom:56px">{resto.map((p) => <a class="card stack" href={`/blog/${p.slug}`}><img src={p.capa} alt="" width="830" height="560" style="height:220px;object-fit:cover" /><div class="stack gap-8" style="padding:24px"><span class="eyebrow" style="font-size:11px">{p.categoria}</span><strong class="h3">{p.titulo}</strong><span class="small muted">{p.autor} · {fmt(p.data)}</span></div></a>)}</section>}
  <p class="wrap small muted" style="padding-bottom:72px">Os artigos são educativos e não substituem a consulta.</p>
</Base>
