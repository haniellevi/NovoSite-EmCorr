---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { equipe, site, wa } from '../../data/site';
---
<Base title="Médicos e dentistas da EmCORR em Corrente-PI" description="Veja os profissionais da EmCORR em Corrente-PI, com registro no conselho publicado. Escolha com quem marcar e agende pelo WhatsApp." nav="Corpo clínico">
  <Crumbs items={[['Início', '/'], ['Corpo clínico']]} />
  <section class="wrap stack gap-20" style="padding-top:32px;padding-bottom:40px;max-width:980px">
    <span class="eyebrow">{site.numeros.profissionais} profissionais</span>
    <h1 class="h1">Profissionais da EmCORR em <em>Corrente</em></h1>
    <p class="lead">Médicos, dentistas e psicóloga que atendem no mesmo endereço. O registro no conselho aparece ao lado de cada nome.</p>
  </section>
  <section class="wrap grid g4" style="padding-bottom:32px">
    {equipe.map((m) => (
      <article class="card stack">
        <img src={m.foto} alt={`${m.nome}, ${m.funcao}, ${m.registro}`} width="480" height="425" loading="lazy" style="width:100%;height:300px;object-fit:cover;object-position:top" />
        <div class="stack gap-8" style="padding:22px;flex-grow:1">
          <span class="eyebrow" style="font-size:11px">{m.area}</span>
          <h2 style="font:600 19px/1.3 Poppins">{m.nome}</h2>
          <span style="font-size:15px">{m.funcao}</span>
          <span class="small muted">{m.registro}{m.rqe ? ` · ${m.rqe}` : ''}</span>
          <div class="row gap-8" style="margin-top:14px;flex-wrap:wrap"><a class="btn btn-s btn-sm" href={`/corpo-clinico/${m.slug}`}>Ver perfil</a><a class="btn btn-p btn-sm" href={wa(`Olá, quero agendar com ${m.nome} na EmCORR.`)}>Agendar</a></div>
        </div>
      </article>
    ))}
  </section>
  <p class="wrap small muted" style="padding-bottom:72px;max-width:900px">A equipe tem {site.numeros.profissionais} profissionais. Os demais perfis entram no site assim que o registro no conselho de cada um for publicado. Enquanto isso, a recepção informa quem atende cada especialidade.</p>
  <CtaBand titulo="Não sabe com quem marcar?" texto="Diga à recepção o que você precisa. Ela indica o profissional e confirma o horário." botao="Falar com a recepção" href={wa('Olá, não sei com qual profissional marcar. Podem me ajudar?')} />
</Base>
